
IDF,
    !-Version Identifier
 
 Version,
    23.2;                    !- Version Identifier

 Timestep,6;               !- Number of Timesteps per Hour

 Building,
    Eco-Loop Office Building,!- Name
    0.0,                     !- North Axis {deg}
    City,                    !- Terrain
    0.04,                    !- Loads Convergence Tolerance Value {W}
    0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
    FullInteriorAndExterior, !- Solar Distribution
    25,                      !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

 ShadowCalculation,
    PolygonClipping,         !- Shading Calculation Method
    Periodic,                !- Shading Calculation Update Frequency Method
    30;                      !- Shading Calculation Update Frequency

 SurfaceConvectionAlgorithm:Inside,TARP;
 SurfaceConvectionAlgorithm:Outside,DOE-2;
 HeatBalanceAlgorithm,ConductionTransferFunction;

 SimulationControl,
    Yes,                     !- Do Zone Sizing Calculation
    Yes,                     !- Do System Sizing Calculation
    Yes,                     !- Do Plant Sizing Calculation
    No,                      !- Run Simulation for Sizing Periods
    Yes,                     !- Run Simulation for Weather File Run Periods
    No,                      !- Do HVAC Sizing Simulation for Sizing Periods
    1;                       !- Maximum Number of HVAC Sizing Simulation Passes

 RunPeriod,
    AnnualRun,               !- Name
    1,                       !- Begin Month
    1,                       !- Begin Day of Month
    ,                        !- Begin Year
    12,                      !- End Month
    31,                      !- End Day of Month
    ,                        !- End Year
    Sunday,                  !- Day of Week for Start Day
    Yes,                     !- Use Weather File Holidays and Special Days
    Yes,                     !- Use Weather File DST Indicators
    Yes,                     !- Apply Weekend Holiday Rule
    Yes,                     !- Use Weather File Rain Indicators
    Yes;                     !- Use Weather File Snow Indicators

 GlobalGeometryRules,
    UpperLeftCorner,         !- Starting Vertex Position
    CounterClockWise,        !- Vertex Entry Direction
    World;                   !- Coordinate System

! ── ZONES ────────────────────────────────────────────────────────────────────

 Zone,
    OFFICE_FLOOR_1,          !- Name
    0,                       !- Direction of Relative North {deg}
    0, 0, 0,                 !- Origin X, Y, Z {m}
    1,                       !- Type
    1,                       !- Multiplier
    autocalculate,           !- Ceiling Height {m}
    autocalculate;           !- Volume {m3}

 Zone,
    OFFICE_FLOOR_2,          !- Name
    0, 0, 0, 4,
    1, 1, autocalculate, autocalculate;

 Zone,
    CONFERENCE_ROOMS,        !- Name
    0, 20, 0, 0,
    1, 1, autocalculate, autocalculate;

 Zone,
    LOBBY_RECEPTION,         !- Name
    0, 30, 0, 0,
    1, 1, autocalculate, autocalculate;

 Zone,
    SERVER_ROOM,             !- Name
    0, 35, 0, 0,
    1, 1, autocalculate, autocalculate;

! ── SCHEDULES ────────────────────────────────────────────────────────────────

 ScheduleTypeLimits,
    Fraction,                !- Name
    0.0,                     !- Lower Limit Value
    1.0,                     !- Upper Limit Value
    Continuous;              !- Numeric Type

 ScheduleTypeLimits,
    Temperature,             !- Name
    -60,                     !- Lower Limit Value
    200,                     !- Upper Limit Value
    Continuous,              !- Numeric Type
    Temperature;             !- Unit Type

 ScheduleTypeLimits,
    OnOff,                   !- Name
    0,                       !- Lower Limit Value
    1,                       !- Upper Limit Value
    Discrete;                !- Numeric Type

! Office occupancy schedule (M-F 8am-6pm)
 Schedule:Compact,
    OFFICE_OCC_SCH,          !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: Weekdays,           !- Field 2
    Until: 08:00, 0.0,       !- Field 3-4
    Until: 09:00, 0.5,       !- Field 5-6
    Until: 17:00, 1.0,       !- Field 7-8
    Until: 18:00, 0.5,       !- Field 9-10
    Until: 24:00, 0.0,       !- Field 11-12
    For: Weekends,           !- Field 13
    Until: 24:00, 0.0,       !- Field 14-15
    For: Holidays,
    Until: 24:00, 0.0,
    For: SummerDesignDay,
    Until: 24:00, 1.0,
    For: WinterDesignDay,
    Until: 24:00, 1.0,
    For: AllOtherDays,
    Until: 24:00, 0.0;

! HVAC Availability schedule
 Schedule:Compact,
    HVAC_AVAIL_SCH,          !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,
    For: Weekdays,
    Until: 07:00, 0.0,
    Until: 19:00, 1.0,
    Until: 24:00, 0.0,
    For: Weekends,
    Until: 24:00, 0.0,
    For: SummerDesignDay WinterDesignDay,
    Until: 24:00, 1.0,
    For: AllOtherDays,
    Until: 24:00, 0.0;

! Heating setpoint schedule
 Schedule:Compact,
    HTGSETP_SCH,             !- Name
    Temperature,
    Through: 12/31,
    For: Weekdays,
    Until: 07:00, 15.6,
    Until: 17:00, 21.0,
    Until: 24:00, 15.6,
    For: Weekends,
    Until: 24:00, 15.6,
    For: SummerDesignDay,
    Until: 24:00, 21.0,
    For: WinterDesignDay,
    Until: 24:00, 21.0,
    For: AllOtherDays,
    Until: 24:00, 15.6;

! Cooling setpoint schedule
 Schedule:Compact,
    CLGSETP_SCH,             !- Name
    Temperature,
    Through: 12/31,
    For: Weekdays,
    Until: 07:00, 30.0,
    Until: 17:00, 24.0,
    Until: 24:00, 30.0,
    For: Weekends,
    Until: 24:00, 30.0,
    For: SummerDesignDay,
    Until: 24:00, 24.0,
    For: WinterDesignDay,
    Until: 24:00, 24.0,
    For: AllOtherDays,
    Until: 24:00, 30.0;

! ── INTERNAL LOADS ────────────────────────────────────────────────────────────

 People,
    OFFICE_FLOOR_1 People,
    OFFICE_FLOOR_1,          !- Zone Name
    OFFICE_OCC_SCH,          !- Number of People Schedule Name
    People/Area,             !- Number of People Calculation Method
    ,                        !- Number of People
    0.2,                     !- People per Zone Floor Area {person/m2}
    ,                        !- Zone Floor Area per Person {m2/person}
    0.3,                     !- Fraction Radiant
    autocalculate,           !- Sensible Heat Fraction
    OFFICE_OCC_SCH;          !- Activity Level Schedule Name

 Lights,
    OFFICE_FLOOR_1 Lights,
    OFFICE_FLOOR_1,          !- Zone Name
    OFFICE_OCC_SCH,          !- Schedule Name
    Watts/Area,              !- Design Level Calculation Method
    ,                        !- Lighting Level {W}
    10.0,                    !- Watts per Zone Floor Area {W/m2}
    ,                        !- Watts per Person {W/person}
    0.0,                     !- Return Air Fraction
    0.42,                    !- Fraction Radiant
    0.18,                    !- Fraction Visible
    1.0,                     !- Fraction Replaceable
    GeneralLights;           !- End-Use Subcategory

 ElectricEquipment,
    OFFICE_FLOOR_1 Equipment,
    OFFICE_FLOOR_1,          !- Zone Name
    OFFICE_OCC_SCH,          !- Schedule Name
    Watts/Area,              !- Design Level Calculation Method
    ,                        !- Design Level {W}
    15.0,                    !- Watts per Zone Floor Area {W/m2}
    ,                        !- Watts per Person {W/person}
    0.0,                     !- Fraction Latent
    0.5,                     !- Fraction Radiant
    0.0;                     !- Fraction Lost

! ── HVAC ──────────────────────────────────────────────────────────────────────

 ThermostatSetpoint:DualSetpoint,
    OFFICE_DUAL_SP,          !- Name
    HTGSETP_SCH,             !- Heating Setpoint Temperature Schedule Name
    CLGSETP_SCH;             !- Cooling Setpoint Temperature Schedule Name

 ZoneControl:Thermostat,
    OFFICE_FLOOR_1 Thermostat,
    OFFICE_FLOOR_1,          !- Zone Name
    OFFICE_OCC_SCH,          !- Control Type Schedule Name
    ThermostatSetpoint:DualSetpoint,
    OFFICE_DUAL_SP;          !- Control Object Name

! ── OUTPUT VARIABLES ─────────────────────────────────────────────────────────

 Output:Variable,*,Zone Mean Air Temperature,TimeStep;
 Output:Variable,*,Zone Mechanical Ventilation Mass Flow Rate,TimeStep;
 Output:Variable,*,Zone People Occupant Count,TimeStep;
 Output:Variable,*,Zone Lights Electric Power,TimeStep;
 Output:Variable,*,Zone Electric Equipment Electric Power,TimeStep;
 Output:Variable,*,Zone Thermostat Cooling Setpoint Temperature,TimeStep;
 Output:Variable,*,Zone Thermostat Heating Setpoint Temperature,TimeStep;
 Output:Variable,*,Facility Total HVAC Electric Demand Power,TimeStep;
 Output:Variable,*,Site Outdoor Air Drybulb Temperature,TimeStep;
 Output:Variable,*,Site Direct Solar Radiation Rate per Area,TimeStep;
 Output:Variable,*,Zone Air Relative Humidity,TimeStep;
 Output:Variable,*,Zone CO2 Concentration,TimeStep;

 Output:Meter,Electricity:Facility,TimeStep;
 Output:Meter,Electricity:HVAC,TimeStep;
 Output:Meter,Electricity:Lighting,TimeStep;

 OutputControl:Table:Style,HTML;
 Output:Table:SummaryReports,AllSummary;
