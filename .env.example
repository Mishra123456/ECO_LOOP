# ── LLM Configuration ─────────────────────────────────────────────────────────
# Option 1: Groq (free, fast, cloud) — get key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Ollama (local, fully offline)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# ── Simulation Configuration ──────────────────────────────────────────────────
ENERGYPLUS_PATH=C:/EnergyPlusV23-2-0/energyplus.exe
ENERGYPLUS_IDF=./simulation/models/office_building.idf
ENERGYPLUS_EPW=./simulation/weather/USA_CA_San.Francisco.724940_TMY3.epw

# ── Control Loop ──────────────────────────────────────────────────────────────
LOOP_INTERVAL_SECONDS=10
COMFORT_PRIORITY=0.5
ELECTRICITY_PRICE_KWH=0.12
CARBON_INTENSITY_KG_KWH=0.233

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///eco_loop.db

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
